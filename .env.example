# DiaNurFx — copy to .env and fill in. .env is gitignored.
# Preferred over bridge/mt5_config.json: no password sits in a file the app reads.
# Safest of all: leave these blank, log in inside the MT5 terminal, and the
# bridge attaches to that already-authenticated session.

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Users\YOU\AppData\Roaming\International Capital Markets MT5 Terminal\terminal64.exe

# Analysis/signal API
DIANUR_HOST=127.0.0.1
DIANUR_PORT=8770
DIANUR_BRIDGE=http://127.0.0.1:8765

# Optional: free-text "ask the analyst" channel. Leave blank to run fully offline.
ANTHROPIC_API_KEY=

# --- Telegram alerts -------------------------------------------------------
# The bot token is a CREDENTIAL and lives only here, never in
# configs/alerts.json - that file is rewritten by the Settings UI, and anything
# that can post as you does not belong in a file the UI overwrites.
# Get one from @BotFather, then add the bot to the chat/group/channel you want
# it to post in and give it permission to post.
TELEGRAM_BOT_TOKEN=

# --- market intelligence / news providers ---------------------------------- #
# Names only. Real values live in .env, which is gitignored.
FRED_API_KEY=
FINNHUB_API_KEY=
XOOMAR_API_KEY=
QUANTGIST_API_KEY=
